{
	"$schema": "https://typedoc.org/schema.json",
	"out": "./docs",
	"entryPoints": ["./src/index.ts"],
	"plugin": ["typedoc-plugin-markdown"],
	"readme": "none",
	"disableGit": true,
	"basePath": ".",
	"intentionallyNotExported": ["HumanReadableAbi", "JsonAbi"],
	"sourceLinkTemplate": "https://github.com/evmts/tevm-contract/blob/main/src/{path}#L{line}",
	"parametersFormat": "table",
	"propertiesFormat": "table"
}
