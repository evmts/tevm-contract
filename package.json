{
	"name": "@tevm/contract",
	"version": "1.0.0",
	"description": "The shared type-safe contract kernel used by Tevm's core node and bundler.",
	"keywords": [
		"ethereum",
		"evm",
		"solidity",
		"tevm",
		"typescript",
		"web3"
	],
	"homepage": "https://contract.tevm.sh",
	"bugs": {
		"url": "https://github.com/evmts/tevm-contract/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/evmts/tevm-contract.git"
	},
	"license": "MIT",
	"contributors": [
		"Will Cory <willcory10@gmail.com>"
	],
	"sideEffects": false,
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"import": {
				"types": "./types/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"src",
		"!src/**/*.spec.ts",
		"!src/test/**",
		"types"
	],
	"scripts": {
		"bench": "vitest bench --run",
		"build": "pnpm run clean:build && pnpm run build:dist && pnpm run build:types",
		"build:dist": "tsup",
		"build:types": "tsup --dts-only && tsc --project tsconfig.build.json --emitDeclarationOnly",
		"changeset": "changeset",
		"check:package": "publint && attw --pack .",
		"clean:build": "rm -rf dist types",
		"docs": "typedoc",
		"docs:build": "pnpm --filter @tevm/contract-docs build",
		"docs:dev": "pnpm --filter @tevm/contract-docs dev",
		"docs:preview": "pnpm --filter @tevm/contract-docs preview",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"release": "pnpm run build && changeset publish",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "node --test test/contract.e2e.mjs",
		"test:fuzz": "vitest run src/contract.fuzz.spec.ts",
		"test:unit": "vitest run --exclude '**/*.fuzz.spec.ts'",
		"typecheck": "tsc --noEmit",
		"version-packages": "changeset version"
	},
	"dependencies": {
		"@tevm/errors": "^1.0.0-next.148",
		"@tevm/utils": "^1.0.0-next.148"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@biomejs/biome": "^2.4.15",
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "^2.31.0",
		"@ethereumjs/evm": "10.1.2",
		"@ethereumjs/util": "10.1.2",
		"@types/node": "^24.13.2",
		"@vitest/coverage-v8": "^4.1.6",
		"fast-check": "^4.11.0",
		"publint": "^0.3.22",
		"tsup": "^8.5.1",
		"typedoc": "^0.28.19",
		"typedoc-plugin-markdown": "^4.11.0",
		"typescript": "^6.0.3",
		"viem": "2.55.10",
		"vitest": "^4.1.6"
	},
	"engines": {
		"node": "^24.0.0"
	},
	"packageManager": "pnpm@9.15.9",
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
